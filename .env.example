#mongoDB 

MONGODB_USERNAME=<user>
MONGODB_PASSWORD=<password>
MONGODB_CLUSTER=<cluster name>
MONGODB_APPNAME=<appname>
MONGODB_DATABASENAME=RealtimeChat-DB
# Optional: use this instead of the individual MongoDB values above.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<appname>

#jwt
JWT_SECRET_KEY= your_jwt_secret_key
JWT_EXPIRATION_TIME= your_jwt_exparation
JWT_REFRESH_SECRET_KEY=your_refresh_secret_key
JWT_REFRESH_TOKEN_EXPIRY_TIME=7d

#server
PORT=<port number>